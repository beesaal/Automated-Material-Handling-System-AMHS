  91:Core/Src/main.c **** uint8_t TaskAdd(void (*FunctionName)(void *argument), /* Function that implements the task. */
  92:Core/Src/main.c **** char *TaskName, /* Text name for the task. */
  93:Core/Src/main.c **** uint16_t StackSize, /* Stack size in words, not bytes. */
  94:Core/Src/main.c **** void *pvParameters, /* Parameter passed into the task. */
  95:Core/Src/main.c **** UBaseType_t uxPriority, /* Priority at which the task is created. */
  96:Core/Src/main.c **** TaskHandle_t *TaskHandle) /* Used to pass out the task’s handle. */
  97:Core/Src/main.c **** {
  98:Core/Src/main.c **** 	BaseType_t retValue = xTaskCreate(FunctionName, TaskName, StackSize,
  99:Core/Src/main.c **** 			pvParameters, uxPriority, TaskHandle);
 100:Core/Src/main.c **** 	if (retValue == pdPASS) {
 101:Core/Src/main.c **** 		printf("---->%s Added\r\n", pcTaskGetName(*TaskHandle));
 102:Core/Src/main.c **** 		return 0;
 103:Core/Src/main.c **** 	} else {
 104:Core/Src/main.c **** 		printf("---->Failed to add %s\r\n", TaskName);
 105:Core/Src/main.c **** 	}
 106:Core/Src/main.c **** 	return 1;
 107:Core/Src/main.c **** }
 108:Core/Src/main.c **** 
 109:Core/Src/main.c **** void KillTask(TaskHandle_t *TaskHandle) {
 110:Core/Src/main.c **** 	vTaskDelete(*TaskHandle);
 111:Core/Src/main.c **** 	printf("---->%s Killed\r\n", pcTaskGetName(*TaskHandle));
 112:Core/Src/main.c **** 	/* Task gets killed when IDLE Task runs */
 113:Core/Src/main.c **** 	*TaskHandle = NULL;
 114:Core/Src/main.c **** }
