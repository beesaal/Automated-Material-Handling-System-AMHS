7801:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @param  TIM_ExtTRGPrescaler The external Trigger Prescaler.
7802:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *          This parameter can be one of the following values:
7803:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV1: ETRP Prescaler OFF.
7804:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV2: ETRP frequency divided by 2.
7805:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV4: ETRP frequency divided by 4.
7806:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV8: ETRP frequency divided by 8.
7807:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @param  TIM_ExtTRGPolarity The external Trigger Polarity.
7808:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *          This parameter can be one of the following values:
7809:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_INVERTED: active low or falling edge active.
7810:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_NONINVERTED: active high or rising edge active.
7811:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @param  ExtTRGFilter External Trigger Filter.
7812:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *          This parameter must be a value between 0x00 and 0x0F
7813:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @retval None
7814:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   */
