ARM GAS  /tmp/cc9ctJuJ.s 			page 2


  28:Core/Src/AGV.c ****     } else if (right_sensor == LINE_DETECTED && left_sensor != LINE_DETECTED) {
  29:Core/Src/AGV.c ****         Motor_TurnRight();
  30:Core/Src/AGV.c ****     } else if (left_sensor == LINE_DETECTED && right_sensor == LINE_DETECTED) {
  31:Core/Src/AGV.c ****         Motor_MoveForward();
  32:Core/Src/AGV.c ****     } else {
  33:Core/Src/AGV.c ****         Motor_Stop();  // Stop if the line is lost
  34:Core/Src/AGV.c ****     }
