 259:Core/Src/AGV.c **** 
 260:Core/Src/AGV.c **** // Smooth start by gradually increasing speed
 261:Core/Src/AGV.c **** void SmoothStart() {
 262:Core/Src/AGV.c ****     printf("Smooth Start...\r\n");
 263:Core/Src/AGV.c **** 	for (current_speed = MIN_SPEED; current_speed <= MAX_SPEED; current_speed +=
 264:Core/Src/AGV.c **** 			SPEED_STEP) {
 265:Core/Src/AGV.c **** 		SetMotorSpeed(current_speed);
 266:Core/Src/AGV.c **** 		HAL_Delay(1);  // Adjust delay for smoother/faster acceleration
 267:Core/Src/AGV.c **** 	}
 268:Core/Src/AGV.c **** 	Motor_MoveForward();
 269:Core/Src/AGV.c **** 	car_moving = 1;
 270:Core/Src/AGV.c **** }
 271:Core/Src/AGV.c **** 
 272:Core/Src/AGV.c **** // Smooth stop by gradually decreasing speed
 273:Core/Src/AGV.c **** void SmoothStop() {
 274:Core/Src/AGV.c ****     printf("Smooth Stop...\r\n");
 275:Core/Src/AGV.c **** 	for (current_speed = MAX_SPEED; current_speed >= MIN_SPEED; current_speed -=
 276:Core/Src/AGV.c **** 			SPEED_STEP) {
 277:Core/Src/AGV.c **** 		SetMotorSpeed(current_speed);
 278:Core/Src/AGV.c **** 		HAL_Delay(1);  // Adjust delay for smoother/faster deceleration
 279:Core/Src/AGV.c **** 	}
 280:Core/Src/AGV.c **** 	Motor_Stop();
 281:Core/Src/AGV.c **** 	car_moving = 0;
 282:Core/Src/AGV.c **** }
