   1:Core/Src/AGV.c **** /**
   2:Core/Src/AGV.c ****  * Basically agv/car will rotate in a loop (line) where there are mainly two ends one where the car
   3:Core/Src/AGV.c ****  * with boxes and another where it will unload the boxes. on both the end there will be line on mid
   4:Core/Src/AGV.c ****  * infron of the two ir sensor, just to make it stop. when it stop at those points whether to load 
   5:Core/Src/AGV.c ****  * or to unload the boxes FSR sensor will signal the car to move forward blindly for like 2 sec and
   6:Core/Src/AGV.c ****  * following algorithm agains kicks in and drive the car to another stop.
   7:Core/Src/AGV.c ****  * 1. agv will wait for the arm to load up the box.
   8:Core/Src/AGV.c ****  * 2. FSR will detect the box whether it's mounted or not
   9:Core/Src/AGV.c ****  * 3. if the FSR is one (meaning the load is mounted) then the car began to move after 2 second tim
  10:Core/Src/AGV.c ****  * 4. The car will follow the path until there is no obstacle infront of it 
ARM GAS  /tmp/cctktfYf.s 			page 3


  11:Core/Src/AGV.c ****  *      (ultrasonic sensor keeps continuosly detecting for the object).
  12:Core/Src/AGV.c ****  * 5. if the ultrasonic sensor detects any object, the car will stop and sound a buzzer.
  13:Core/Src/AGV.c ****  * 6. ultrasonic sensor is still detecting whether the object has been removed from the path or not
  14:Core/Src/AGV.c ****  *      if removed then will send signal as (car_moving = 0 ) when car_moving is zero then car bega
  15:Core/Src/AGV.c ****  *      after 2 sec.
  16:Core/Src/AGV.c ****  * 7. the car will stop when it doesn't see any path :
  17:Core/Src/AGV.c ****  *      meaning:
  18:Core/Src/AGV.c ****  *              left side closed 
  19:Core/Src/AGV.c ****  *              right side closed and 
  20:Core/Src/AGV.c ****  *              front side closed too.
  21:Core/Src/AGV.c ****  * 8. car will wait for there till the box has been uloaded:
  22:Core/Src/AGV.c ****  FSR = 0;
  23:Core/Src/AGV.c ****  9. When FSR = 0 the car will move after like 2 second
  24:Core/Src/AGV.c ****  10. Then same loop continues.
  25:Core/Src/AGV.c ****  * **/
  26:Core/Src/AGV.c **** #include "AGV.h"
  27:Core/Src/AGV.c **** 
  28:Core/Src/AGV.c **** uint8_t car_moving = 0;
  29:Core/Src/AGV.c **** uint16_t current_speed = MIN_SPEED;
  30:Core/Src/AGV.c **** 
  31:Core/Src/AGV.c **** static uint8_t load = 0;
  32:Core/Src/AGV.c **** 
  33:Core/Src/AGV.c **** // Define AGV states for non-blocking obstacle and line-following handling
  34:Core/Src/AGV.c **** typedef enum {
  35:Core/Src/AGV.c **** 	AGV_STATE_LINE_FOLLOWING,
  36:Core/Src/AGV.c **** 	AGV_STATE_OBSTACLE_DETECTED,
  37:Core/Src/AGV.c **** 	AGV_STATE_OBSTACLE_CLEAR,
  38:Core/Src/AGV.c **** 	AGV_STATE_STOP_STATION
  39:Core/Src/AGV.c **** } AGV_State;
  40:Core/Src/AGV.c **** 
  41:Core/Src/AGV.c **** AGV_State current_state = AGV_STATE_LINE_FOLLOWING;
  42:Core/Src/AGV.c **** 
  43:Core/Src/AGV.c **** void Obstacle_CheckAndHandle() {
  44:Core/Src/AGV.c **** 	uint16_t distance = 10;
  45:Core/Src/AGV.c ****     printf("Obstacle_Check\r\nObstacle distance: %d\r\n", distance);
  46:Core/Src/AGV.c **** 
  47:Core/Src/AGV.c **** 	switch (current_state) {
  48:Core/Src/AGV.c **** 	case AGV_STATE_LINE_FOLLOWING:
  49:Core/Src/AGV.c **** 		// Check for obstacles only in line-following state
  50:Core/Src/AGV.c **** 		if (distance < OBSTACLE_THRESHOLD) {
  51:Core/Src/AGV.c **** 			printf("Obstacle detected, stopping AGV...\r\n");
  52:Core/Src/AGV.c **** 			SmoothStop();
  53:Core/Src/AGV.c **** 			HAL_GPIO_TogglePin(GPIOB, BUZZER_Pin);  // Turn buzzer on
  54:Core/Src/AGV.c **** 			current_state = AGV_STATE_OBSTACLE_DETECTED;
  55:Core/Src/AGV.c **** 		}
  56:Core/Src/AGV.c **** 		break;
  57:Core/Src/AGV.c **** 
  58:Core/Src/AGV.c **** 	case AGV_STATE_OBSTACLE_DETECTED:
  59:Core/Src/AGV.c **** 		// Wait until obstacle clears without blocking
  60:Core/Src/AGV.c **** 		if (distance >= OBSTACLE_THRESHOLD) {
  61:Core/Src/AGV.c **** 			printf("Obstacle cleared, resuming AGV...\r\n");
  62:Core/Src/AGV.c **** 			HAL_GPIO_WritePin(GPIOB, BUZZER_Pin, GPIO_PIN_RESET); // Turn buzzer off
  63:Core/Src/AGV.c **** 			current_state = AGV_STATE_OBSTACLE_CLEAR;
  64:Core/Src/AGV.c **** 		}
  65:Core/Src/AGV.c **** 		break;
  66:Core/Src/AGV.c **** 
  67:Core/Src/AGV.c **** 	case AGV_STATE_OBSTACLE_CLEAR:
ARM GAS  /tmp/cctktfYf.s 			page 4


  68:Core/Src/AGV.c **** 		HAL_Delay(2000);  // Wait briefly before resuming
  69:Core/Src/AGV.c **** 		SmoothStart();
  70:Core/Src/AGV.c **** 		current_state = AGV_STATE_LINE_FOLLOWING; // Return to line-following mode
  71:Core/Src/AGV.c **** 		break;
  72:Core/Src/AGV.c **** 
  73:Core/Src/AGV.c **** 	case AGV_STATE_STOP_STATION:
  74:Core/Src/AGV.c **** 		//wait for (2 sec) at the station, to be loaded
  75:Core/Src/AGV.c **** 		SmoothStop();
  76:Core/Src/AGV.c **** 		HAL_Delay(2000);  // Pause for 2 seconds (adjust as needed)
  77:Core/Src/AGV.c **** 
  78:Core/Src/AGV.c **** 		if (load == 0) {
  79:Core/Src/AGV.c **** 			if (HAL_GPIO_ReadPin(FSR_GPIO_Port, FSR_Pin) == GPIO_PIN_SET) { // Box loaded
  80:Core/Src/AGV.c **** 				load = 1;
  81:Core/Src/AGV.c **** 				SmoothStart();
  82:Core/Src/AGV.c **** 				HAL_Delay(1500);
  83:Core/Src/AGV.c **** 				current_state = AGV_STATE_LINE_FOLLOWING;
  84:Core/Src/AGV.c **** 			} else {  // Box not loaded, wait to be loaded
  85:Core/Src/AGV.c **** 				current_state = AGV_STATE_STOP_STATION;
  86:Core/Src/AGV.c **** 			}
  87:Core/Src/AGV.c **** 
  88:Core/Src/AGV.c **** 		} else {
  89:Core/Src/AGV.c **** 			if (HAL_GPIO_ReadPin(FSR_GPIO_Port, FSR_Pin) == GPIO_PIN_RESET) { // Box unloaded
  90:Core/Src/AGV.c **** 				load = 0;
  91:Core/Src/AGV.c **** 				SmoothStart();
  92:Core/Src/AGV.c **** 				HAL_Delay(1500);
  93:Core/Src/AGV.c **** 				current_state = AGV_STATE_LINE_FOLLOWING;
  94:Core/Src/AGV.c **** 			} else {  // Box loaded, wait to be unloaded
  95:Core/Src/AGV.c **** 				current_state = AGV_STATE_STOP_STATION;
  96:Core/Src/AGV.c **** 			}
  97:Core/Src/AGV.c **** 		}
  98:Core/Src/AGV.c **** 		break;
  99:Core/Src/AGV.c **** 
 100:Core/Src/AGV.c **** 	default:
 101:Core/Src/AGV.c **** 		printf("This is a default message.\r\n");
 102:Core/Src/AGV.c **** 		current_state = AGV_STATE_LINE_FOLLOWING;
 103:Core/Src/AGV.c **** 	}
 104:Core/Src/AGV.c **** }
 105:Core/Src/AGV.c **** 
 106:Core/Src/AGV.c **** void LineFollowing() {
 107:Core/Src/AGV.c **** 
 108:Core/Src/AGV.c ****     printf("LineFollowing...\r\n");
 109:Core/Src/AGV.c **** 	// Only perform line-following if in LINE_FOLLOWING state
 110:Core/Src/AGV.c **** 	if (current_state == AGV_STATE_LINE_FOLLOWING) {
 111:Core/Src/AGV.c **** 		uint8_t left_sensor = 0;
 112:Core/Src/AGV.c **** 		uint8_t right_sensor = 0;
 113:Core/Src/AGV.c **** 
 114:Core/Src/AGV.c **** 		if (HAL_GPIO_ReadPin(LEFT_IR_GPIO_Port, LEFT_IR_Pin)) {
 115:Core/Src/AGV.c **** 			left_sensor = LINE_DETECTED;
 116:Core/Src/AGV.c **** 		}
 117:Core/Src/AGV.c **** 		if (HAL_GPIO_ReadPin(RIGHT_IR_GPIO_Port, RIGHT_IR_Pin)) {
 118:Core/Src/AGV.c **** 			right_sensor = LINE_DETECTED;
 119:Core/Src/AGV.c **** 		}
 120:Core/Src/AGV.c **** 
 121:Core/Src/AGV.c **** 		if (left_sensor == LINE_DETECTED && right_sensor != LINE_DETECTED) {
 122:Core/Src/AGV.c **** 			printf("Turning Right.\r\n");
 123:Core/Src/AGV.c **** 			Motor_TurnRight();
 124:Core/Src/AGV.c **** 		} else if (left_sensor != LINE_DETECTED && right_sensor == LINE_DETECTED) {
ARM GAS  /tmp/cctktfYf.s 			page 5


 125:Core/Src/AGV.c **** 			printf("Turning Left.\r\n");
 126:Core/Src/AGV.c **** 			Motor_TurnLeft();
 127:Core/Src/AGV.c **** 		} else if (left_sensor == LINE_DETECTED && right_sensor == LINE_DETECTED) {
 128:Core/Src/AGV.c **** 
 129:Core/Src/AGV.c **** 			printf("Moving Forward.\r\n");
 130:Core/Src/AGV.c **** 			Motor_MoveForward();
 131:Core/Src/AGV.c **** 			current_state = AGV_STATE_LINE_FOLLOWING;
 132:Core/Src/AGV.c **** 		} else {
 133:Core/Src/AGV.c **** 			printf("Station_Stop.\r\n");
 134:Core/Src/AGV.c **** 			current_state = AGV_STATE_STOP_STATION;
 135:Core/Src/AGV.c **** 		}
 136:Core/Src/AGV.c **** 	}
 137:Core/Src/AGV.c **** }
 138:Core/Src/AGV.c **** 
