  11:Core/Src/AGV.c **** void Obstacle_CheckAndHandle() {
  12:Core/Src/AGV.c ****     uint16_t distance = Ultrasonic_GetDistance();
  13:Core/Src/AGV.c ****     if (distance < OBSTACLE_THRESHOLD) {
  14:Core/Src/AGV.c ****         Motor_Stop();
  15:Core/Src/AGV.c ****         HAL_GPIO_WritePin(GPIOB, BUZZER_Pin, GPIO_PIN_SET);  // Turn buzzer on
  16:Core/Src/AGV.c ****         while (Ultrasonic_GetDistance() < OBSTACLE_THRESHOLD);  // Wait until obstacle clears
  17:Core/Src/AGV.c ****         HAL_GPIO_WritePin(GPIOB, BUZZER_Pin, GPIO_PIN_RESET); // Turn buzzer off
  18:Core/Src/AGV.c ****         Motor_MoveForward();
  19:Core/Src/AGV.c ****     }
  20:Core/Src/AGV.c **** }
