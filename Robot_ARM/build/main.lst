 257:Core/Src/main.c **** void bluetooth_comm(void *argument){
 258:Core/Src/main.c **** 
 259:Core/Src/main.c ****     // Enable UART reception with interrupt
 260:Core/Src/main.c ****     HAL_UART_Receive_IT(&huart1, rxBuffer, BUFFER_SIZE);
 261:Core/Src/main.c **** 
 262:Core/Src/main.c ****   for(;;){
 263:Core/Src/main.c ****         // Check if data was received
 264:Core/Src/main.c ****         if (received) {
 265:Core/Src/main.c ****             printf("Received: %s\n", rxBuffer);
 266:Core/Src/main.c ****             received = 0;  // Clear the flag
 267:Core/Src/main.c ****         }
 268:Core/Src/main.c **** 
 269:Core/Src/main.c ****         // Send a message periodically
 270:Core/Src/main.c ****         sendBluetoothData_IT("Hello from STM32F411RE!");
ARM GAS  /tmp/ccKWmiiR.s 			page 7


 271:Core/Src/main.c **** 
 272:Core/Src/main.c ****         // Add a small delay between transmissions
 273:Core/Src/main.c ****         vTaskDelay(1000);
 274:Core/Src/main.c ****   
 275:Core/Src/main.c ****   }
 276:Core/Src/main.c **** }
