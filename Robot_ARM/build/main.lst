 279:Core/Src/main.c **** // Function to clear the terminal screen
 280:Core/Src/main.c **** void clearScreen(void *argument) {
 281:Core/Src/main.c ****   for (;;) {
 282:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET) {
 283:Core/Src/main.c **** 
 284:Core/Src/main.c ****       // ANSI escape code to clear the screen and move cursor to home position
 285:Core/Src/main.c ****       const char *clearCommand = "\033[2J\033[H";
 286:Core/Src/main.c ****       HAL_UART_Transmit(&huart2, (uint8_t*) clearCommand, strlen(clearCommand),
 287:Core/Src/main.c ****       HAL_MAX_DELAY);
 288:Core/Src/main.c ****       
 289:Core/Src/main.c ****       vTaskDelay(200);
 290:Core/Src/main.c ****     }
 291:Core/Src/main.c ****   }
 292:Core/Src/main.c **** }
