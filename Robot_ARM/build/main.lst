 126:Core/Src/main.c **** void KillTask(TaskHandle_t *TaskHandle) {
 127:Core/Src/main.c ****   vTaskDelete(*TaskHandle);
 128:Core/Src/main.c ****   printf("---->%s Killed\r\n", pcTaskGetName(*TaskHandle));
 129:Core/Src/main.c ****   /* Task gets killed when IDLE Task runs */
 130:Core/Src/main.c ****   *TaskHandle = NULL;
 131:Core/Src/main.c **** }
